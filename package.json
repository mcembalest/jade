{
  "name": "jade-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node engine/web/build.mjs",
    "test": "npm run build && go test -race ./... && playwright test",
    "test:setup": "playwright install chromium webkit",
    "test:report": "playwright show-report .tmp/test-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
