{
  "name": "jade-personal-sync",
  "main": "production.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jade-personal-sync",
      "database_id": "cb3fa378-dbf0-475d-be9c-f1d39489e3f6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "jade-personal-backups"
    }
  ],
  "triggers": {
    "crons": [
      "17 7 * * *",
      "0 * * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "ResearchContainer",
      "image": "./runtime/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RESEARCH",
        "class_name": "ResearchContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "research-v1",
      "new_sqlite_classes": [
        "ResearchContainer"
      ]
    }
  ]
}
